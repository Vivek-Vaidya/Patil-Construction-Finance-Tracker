# Environment Variables — Patil Construction Finance Tracker
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Rotate any secret that is accidentally committed.

# ─── Database ───────────────────────────────────────────────
# Neon Postgres pooled connection (used by Prisma at runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"

# Neon Postgres direct connection (used by Prisma migrate / seed only)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Auth (NextAuth / Auth.js) ───────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Public URL of the deployed app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── App ────────────────────────────────────────────────────
# Site / company name shown in the UI
NEXT_PUBLIC_APP_NAME="Patil Construction Finance Tracker"
NEXT_PUBLIC_COMPANY_NAME="Yashodeep Patil Construction"

# ─── File uploads (local dev: ./public/uploads, prod: set to S3/Cloudinary URL)
UPLOAD_DIR="./public/uploads"

# ─── Optional: Resend (email notifications — leave blank to skip)
RESEND_API_KEY=""
EMAIL_FROM=""

